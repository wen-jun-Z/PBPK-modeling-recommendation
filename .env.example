POSTGRES_DB=pbpk_kb
POSTGRES_USER=pbpk
POSTGRES_PASSWORD=pbpk_password
POSTGRES_PORT=5432
API_PORT=8000
STREAMLIT_PORT=8501

DATABASE_URL=postgresql+psycopg://pbpk:pbpk_password@localhost:5432/pbpk_kb
API_BASE_URL=http://localhost:8000
PBPK_SOURCE_REGISTRY_PATH=pbpk_kb/config/sources.yaml
PBPK_SERVICE_NAME=pbpk-stage1-public-kb
PBPK_SERVICE_VERSION=0.1.0

# Optional path overrides. Defaults use SU700 when mounted, otherwise project-local paths.
PBPK_RAW_OUTPUT_ROOT=
PBPK_PROCESSING_OUTPUT_ROOT=
PBPK_RECOMMENDATION_QUALITY_DIR=
PBPK_MODEL_MATCHING_ROOT=

# Optional OpenAI-compatible LLM endpoint for assisted evidence extraction.
PBPK_LLM_API_KEY=
PBPK_LLM_BASE_URL=local://qwen3-8b
PBPK_LLM_MODEL=Qwen3-8B-BF16
PBPK_EVIDENCE_LLM_ENABLED=false
PBPK_EVIDENCE_LLM_BACKEND=local

# Query embeddings are served by the same PubMedBERT model used for the RAG index.
PBPK_EMBEDDING_API_URL=http://localhost:8010
PBPK_EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
PBPK_EMBEDDING_TIMEOUT_SECONDS=30

# Server-only recommendation runtime. Keep disabled on local workstations.
PBPK_RECOMMENDATION_ONLINE_ENABLED=false
PBPK_RECOMMENDATION_DEVICE=cuda:0
PBPK_RECOMMENDATION_GRAPH_DIR=
PBPK_RECOMMENDATION_SUBGRAPH_DIR=
PBPK_RECOMMENDATION_EMBEDDING_INDEX_DIR=
PBPK_RECOMMENDATION_GNN_BENCHMARK_DIR=
PBPK_RECOMMENDATION_GNN_TRAINING_DIR=
PBPK_RECOMMENDATION_GNN_INDEX_DIR=
PBPK_RECOMMENDATION_MODEL_CACHE_DIR=
PBPK_RECOMMENDATION_GATE5_DIR=
PBPK_RECOMMENDATION_GATE6_DIR=
PBPK_RECOMMENDATION_LLM_MODEL_PATH=
PBPK_RECOMMENDATION_ONLINE_OUTPUT_DIR=
PBPK_RECOMMENDATION_DENSE_BATCH_SIZE=32
PBPK_RECOMMENDATION_RERANKER_BATCH_SIZE=16
PBPK_RECOMMENDATION_BLAS_THREADS=1
PBPK_RECOMMENDATION_TORCH_THREADS=4
PBPK_RECOMMENDATION_TORCH_INTEROP_THREADS=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Accepted Model KG used to prove different-compound mechanism relevance.
# Both paths are required; missing or checksum-invalid graphs fail closed.
PBPK_MODEL_KG_SQLITE=
PBPK_MODEL_KG_AUDIT=

# Immutable public-model matching evaluation artifacts exposed by the API/UI.
PBPK_MODEL_MATCHING_EVALUATION_MANIFEST=
PBPK_MODEL_MATCHING_SUITE_MANIFEST=
PBPK_MODEL_MATCHING_STATISTICS_PATH=
PBPK_MODEL_MATCHING_SIMULATION_PATH=
PBPK_MODEL_MATCHING_PERTURBATION_SIMULATION_PATH=
PBPK_MODEL_MATCHING_RESEARCH_REPORT_PATH=
PBPK_MODEL_MATCHING_CONDITIONAL_REPORT_PATH=
# Set only to a checksum-valid, accepted execution-derived serving manifest.
PBPK_MODEL_MATCHER_SERVING_MANIFEST=
